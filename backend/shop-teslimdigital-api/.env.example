NODE_ENV=production

# In Railway, set this as the Postgres service reference:
# ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Generate a unique, long random value in Railway's Variables UI.
JWT_SECRET=replace-with-a-long-random-secret

# Set this to the deployed Vercel frontend URL after it is available.
FRONTEND_URL=

# Optional: required only when order email delivery is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Teslim Digital" <orders@teslimdigital.com>

# Payment is provider-neutral by default. Configure a provider adapter and its
# secrets only when the corresponding checkout integration is enabled.
PAYMENT_PROVIDER=manual
PAYMENT_CURRENCY=NGN
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
STRIPE_SECRET_KEY=
