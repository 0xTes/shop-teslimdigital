# The public Railway API URL, including the /api suffix.
VITE_API_URL=http://localhost:3000/api

# Canonical frontend URL used for metadata and generated links.
VITE_APP_URL=http://localhost:5173

# When true, all storefront routes render the maintenance page without mounting storefront features.
VITE_MAINTENANCE_MODE=false

# Optional Google Analytics Measurement ID (for example G-XXXXXXXXXX).
VITE_GA_MEASUREMENT_ID=
